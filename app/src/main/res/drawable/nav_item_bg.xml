<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When selected: Gold Pill Background with Spacing -->
    <item android:state_checked="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="4dp" android:insetBottom="4dp">
            <shape>
                <solid android:color="#D8B07D" />
                <corners android:radius="24dp" />
            </shape>
        </inset>
    </item>

    <!-- When unselected: Transparent Background -->
    <item android:drawable="@android:color/transparent" />
</selector>