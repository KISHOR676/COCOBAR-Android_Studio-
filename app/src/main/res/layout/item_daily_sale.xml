<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/tvDateDayNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#312018"/>
        <TextView
            android:id="@+id/tvDateMonthYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May\n2025"
            android:textSize="10sp"
            android:gravity="center"
            android:textColor="#888888"/>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#EEEEEE"
        android:layout_marginHorizontal="12dp"/>

    <TextView
        android:id="@+id/tvDayOfWeek"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Monday"
        android:textColor="#594A42"
        android:textStyle="bold"
        android:textSize="14sp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">
        <TextView
            android:id="@+id/tvDailyRevenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0.00"
            android:textColor="#388E3C"
            android:textStyle="bold"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/tvDailyStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Orders • 0 Items"
            android:textSize="12sp"
            android:textColor="#888888"/>
    </LinearLayout>
</LinearLayout>