<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coco_bg_outer"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- Main Beige Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mainCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@color/coco_card_beige"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toTopOf="@id/tvFooterRegister"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.3">

            <!-- ONE Single Container for everything inside the card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Top Banner Image (CardView automatically rounds the top corners) -->
                <ImageView
                    android:id="@+id/imgBanner"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:contentDescription="Cocobar Banner"
                    android:scaleType="centerCrop"
                    android:src="@drawable/coco_banner" />

                <!-- 2. Titles Area -->
                <TextView
                    android:id="@+id/tvWelcomeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="Welcome Back"
                    android:textColor="@color/coco_text_dark"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="Login to manage your inventory"
                    android:textColor="@color/coco_text_dark"
                    android:textSize="16sp" />

                <!-- 3. Inner Dark Form Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_inner_form"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <!-- Business Email (ID Updated to etLoginEmail) -->
                    <EditText
                        android:id="@+id/etLoginEmail"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input_pill"
                        android:hint="Business Email"
                        android:inputType="textEmailAddress"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:textColor="@color/coco_text_dark"
                        android:textColorHint="@color/coco_hint_dark"
                        android:textSize="16sp" />

                    <!-- Divider -->
                    <include layout="@layout/layout_divider" />

                    <!-- Password (ID Updated to etLoginPassword) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/coco_text_dark"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLoginPassword"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_input_pill"
                            android:hint="Password"
                            android:inputType="textPassword"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:textColor="@color/coco_text_dark"
                            android:textColorHint="@color/coco_hint_dark"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- 4. LOGIN Button -->
                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_button_gold"
                        android:fontFamily="serif"
                        android:text="LOGIN"
                        android:textColor="@color/coco_form_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <!-- Forgot Password (Inside Card) -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Forgot Password?"
                    android:textColor="@color/coco_text_dark"
                    android:textSize="15sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Footer Text (Outside Card) (ID Updated to tvFooterRegister) -->
        <TextView
            android:id="@+id/tvFooterRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Don't have an account? Register here."
            android:textColor="@color/coco_text_light"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>