<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coco_main_beige">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cocobar_banner_bg"
            app:title="Settings"
            app:titleTextColor="@color/coco_gold"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toTopOf="@+id/bottom_nav_wrapper">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Account Info -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Account Profile" android:textStyle="bold" android:textColor="#312018" android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/white" android:padding="16dp" android:orientation="vertical" android:elevation="2dp">
                    <EditText android:id="@+id/etDisplayName" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Display Name (e.g., Cocobar)" android:padding="12dp" android:background="#F4EBDD"/>
                    <Button android:id="@+id/btnSaveName" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Update Name" android:backgroundTint="#4E2B1D" android:textColor="@color/white" android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- 2. Network Config -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Server Configuration" android:textStyle="bold" android:textColor="#312018" android:layout_marginTop="24dp" android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/white" android:padding="16dp" android:orientation="vertical" android:elevation="2dp">
                    <EditText android:id="@+id/etServerIp" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="http://192.168.x.x:8080" android:padding="12dp" android:background="#F4EBDD"/>
                    <Button android:id="@+id/btnSaveIp" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Save Server IP" android:backgroundTint="#4E2B1D" android:textColor="@color/white" android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- 3. Security -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Security" android:textStyle="bold" android:textColor="#312018" android:layout_marginTop="24dp" android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/white" android:padding="16dp" android:orientation="vertical" android:elevation="2dp">
                    <EditText android:id="@+id/etOldPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Current Password" android:inputType="textPassword" android:padding="12dp" android:background="#F4EBDD" android:layout_marginBottom="8dp"/>
                    <EditText android:id="@+id/etNewPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="New Password" android:inputType="textPassword" android:padding="12dp" android:background="#F4EBDD"/>
                    <Button android:id="@+id/btnChangePassword" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Change Password" android:backgroundTint="#388E3C" android:textColor="@color/white" android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- 4. Sync Status -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="System Status" android:textStyle="bold" android:textColor="#312018" android:layout_marginTop="24dp" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tvSyncStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Last Synced: Just Now" android:padding="16dp" android:background="@color/white" android:elevation="2dp" android:textColor="#594A42" android:layout_marginBottom="24dp"/>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar Wrapper -->
        <FrameLayout
            android:id="@+id/bottom_nav_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <include layout="@layout/layout_bottom_navigation" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/nav_sidebar_content" />

</androidx.drawerlayout.widget.DrawerLayout>